{
  "name": "audio-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/audio-cli/src",
  "projectType": "application",
  "tags": ["scope:cli"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/audio-cli"],
      "options": {
        "command": "esbuild apps/audio-cli/src/main.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/apps/audio-cli/main.js --tsconfig=apps/audio-cli/tsconfig.app.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/audio-cli",
        "command": "vitest run"
      }
    }
  }
}
