{
  "name": "audio-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/audio-core/src",
  "projectType": "library",
  "tags": ["scope:core"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/audio-core",
        "main": "libs/audio-core/src/index.ts",
        "tsConfig": "libs/audio-core/tsconfig.lib.json",
        "assets": []
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/audio-core",
        "command": "vitest run"
      }
    }
  }
}